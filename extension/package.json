{
  "name": "vscode-replay-extension",
  "displayName": "VS Code Replay",
  "description": "Replay staged coding sessions from workspace-local manifests.",
  "version": "0.1.0",
  "publisher": "local",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "web"
  ],
  "activationEvents": [
    "*",
    "onStartupFinished",
    "onCommand:vscodeReplay.start"
  ],
  "main": "./extension.js",
  "browser": "./dist/browser.js",
  "contributes": {
    "commands": [
      {
        "command": "vscodeReplay.start",
        "title": "VS Code Replay: Start"
      }
    ]
  }
}
